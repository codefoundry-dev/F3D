model File {
  id             String   @id @default(uuid())
  bucket         String   @db.VarChar(100)
  key            String   @db.VarChar(500)
  filename       String   @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  size           Int
  // Nullable since FOR-290: files that arrive on the invoice-intake email inbox
  // have no uploading user.
  uploadedById   String?  @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  uploadedBy          User?               @relation(fields: [uploadedById], references: [id])
  documents           CompanyDocument[]
  rfqDocuments        RfqDocument[]
  invoiceDocuments    InvoiceDocument[]
  poDocuments         PoDocument[]
  messageAttachments  MessageAttachment[]
  quoteAttachments    QuoteAttachment[]   @relation("QuoteAttachment")
  docExtractions      DocExtraction[]
  deliveryDamagePhotos      DeliveryDamagePhoto[]      @relation("DeliveryDamagePhotoFile")
  deliveryReportAttachments DeliveryReportAttachment[] @relation("DeliveryReportAttachmentFile")
  // Requester-uploaded line photos (FOR-404); one file can sit on an MR line
  // and on the RFQ / PO lines converted from it.
  materialRequestLinePhotos MaterialRequestLineItem[]  @relation("MaterialRequestLinePhoto")
  rfqLinePhotos             RfqLineItem[]              @relation("RfqLinePhoto")
  poLinePhotos              PoLineItem[]               @relation("PoLinePhoto")

  @@index([uploadedById], map: "idx_files_uploaded_by")
  @@map("files")
}
