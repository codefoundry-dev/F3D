enum InvoiceStatus {
  PENDING
  APPROVED
  DISPUTED
  PAID
  REJECTED
}

// How an invoice entered the system (FOR-290): uploaded by the buyer team or
// received on the company's invoice-intake email inbox.
enum InvoiceSource {
  MANUAL
  EMAIL
}

model Invoice {
  id              String        @id @default(uuid())
  // projectId/vendorId/totalAmount are nullable since FOR-290: intake creates
  // the record before review (FOR-291) has identified them. approveInvoice
  // refuses invoices where they are still null.
  projectId       String?       @map("project_id")
  companyId       String        @map("company_id")
  vendorId        String?       @map("vendor_id")
  relatedPoId     String?       @map("related_po_id")
  status          InvoiceStatus @default(PENDING)
  source          InvoiceSource @default(MANUAL)
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(18, 4)
  dueDate         DateTime?     @map("due_date")
  // Extracted-then-reviewed header fields (FOR-291): the vendor's own invoice
  // number and issue date, as printed on the document.
  invoiceNumber   String?       @map("invoice_number") @db.VarChar(100)
  issuedDate      DateTime?     @map("issued_date")
  // Stamped when a human confirmed/corrected the extracted fields (FOR-291).
  // Provenance only — approvability is still gated on vendor/project/total
  // being present, not on this stamp.
  reviewedByUserId String?      @map("reviewed_by_user_id")
  reviewedAt       DateTime?    @map("reviewed_at")
  // Email-intake provenance (FOR-290): the address the invoice came from, and
  // the provider's received-email id — the idempotency key that stops webhook
  // retries from creating the same invoices twice.
  senderEmail     String?       @map("sender_email") @db.VarChar(255)
  intakeEmailId   String?       @map("intake_email_id") @db.VarChar(255)
  // Free-text reason captured when a contractor rejects / disputes the invoice
  // (US 8.05/8.06). Carried into the vendor's rejection email as the user
  // comment, so it must survive the request that set the status.
  rejectionReason String?       @map("rejection_reason")
  // Reminder ledger (US 8.09). The daily sweep claims an invoice by stamping the
  // column before it sends, so a re-run — or a second container — can never
  // re-send the same reminder. There is no API that moves `dueDate` after
  // creation; if one is ever added it must clear these so the new date is
  // reminded on.
  dueReminderSentAt     DateTime? @map("due_reminder_sent_at")
  overdueReminderSentAt DateTime? @map("overdue_reminder_sent_at")
  // Nullable since FOR-290: email-intake invoices have no creating user.
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  project    Project?       @relation(fields: [projectId], references: [id])
  company    Company        @relation("InvoiceCompany", fields: [companyId], references: [id])
  vendor     Company?       @relation("InvoiceVendor", fields: [vendorId], references: [id])
  relatedPo  PurchaseOrder? @relation("InvoiceRelatedPo", fields: [relatedPoId], references: [id])
  createdBy  User?          @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy User?          @relation("InvoiceReviewedBy", fields: [reviewedByUserId], references: [id])
  documents  InvoiceDocument[]
  lines      InvoiceLineItem[]

  @@index([companyId], map: "idx_invoices_company")
  @@index([projectId], map: "idx_invoices_project")
  @@index([vendorId], map: "idx_invoices_vendor")
  @@index([status], map: "idx_invoices_status")
  // Drives the daily payment-reminder sweep, which scans APPROVED invoices by
  // due date (US 8.09).
  @@index([status, dueDate], map: "idx_invoices_status_due_date")
  // Webhook-retry idempotency lookups (FOR-290).
  @@index([intakeEmailId], map: "idx_invoices_intake_email")
  @@map("invoices")
}

// The invoice's billed lines as confirmed at review (FOR-291). Seeded from the
// Gemini extraction, then corrected by the reviewer; the review save replaces
// the full set. PO-line matching (FOR-293) and cost/GL coding (FOR-295) build
// on these rows.
model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  // Order the lines appear on the document; review saves rewrite the set, so
  // positions are always 0..n-1.
  position    Int
  // The invoice's own printed line number / line item ID, when it has one.
  lineId      String?  @map("line_id") @db.VarChar(64)
  description String
  quantity    Decimal? @db.Decimal(18, 4)
  unit        String?  @db.VarChar(32)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(18, 4)
  lineTotal   Decimal? @map("line_total") @db.Decimal(18, 4)
  // Buyer-side accounting coding (FOR-295): set by the reviewer, not extracted
  // from the document. Export-ready — no accounting-system posting this phase.
  costCode    String?  @map("cost_code") @db.VarChar(64)
  glAccount   String?  @map("gl_account") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_line_items_invoice")
  @@map("invoice_line_items")
}

model InvoiceDocument {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@index([invoiceId], map: "idx_invoice_documents_invoice")
  @@map("invoice_documents")
}
