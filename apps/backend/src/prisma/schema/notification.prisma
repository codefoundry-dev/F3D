// In-app notification feed. Each row is one notification for one user, mirroring
// the events that also send a branded transactional email plus new message-thread
// messages. Surfaced on the header bell (badge + panel + detail modal) and pushed
// live over SSE. See docs/adr/0011-notifications.md for the broader design.

enum NotificationType {
  RFQ_RECEIVED
  // Buyer-side mirror of the send (FOR-351): every member of every project the
  // RFQ spans gets this when the RFQ goes out to vendors — the in-app
  // counterpart of the FOR-255 email CC. The sender is excluded (they acted).
  RFQ_SENT
  QUOTE_SUBMITTED
  QUOTE_UPDATED
  PO_ISSUED
  PO_PENDING_APPROVAL
  // The PO reached PENDING_APPROVAL but its Approver Pool is empty — nobody's
  // cap covers the total (FOR-302). Goes to Company Admins as a fallback
  // recipient and to the creator; it asks for a limit raise or a smaller
  // order, and confers no authority to approve.
  PO_APPROVAL_UNROUTABLE
  PO_DECLINED
  // The CHANGE_REQUEST_* trio covers both bulk-agreement and PO change requests
  // — `entityType` (BULK_ORDER vs PURCHASE_ORDER) is what tells them apart.
  CHANGE_REQUEST_PROPOSED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  // An INTERNAL (non-commercial) PO change applies without counterparty
  // approval, so it notifies rather than asks — hence its own type.
  PO_INTERNAL_CHANGE
  BULK_ORDER_CANCELLED
  INVOICE_REJECTED
  // Invoice equivalents of the PO pair above (FOR-307). The reviewed total went
  // over the *reviewer's* `invoice.approve` cap, so the invoice was routed to
  // the Approver Pool; UNROUTABLE is the same empty-Pool fallback FOR-302
  // introduced for POs — a recipient-only signal that confers no authority.
  INVOICE_PENDING_APPROVAL
  INVOICE_APPROVAL_UNROUTABLE
  // Material-request equivalents of the two pairs above (FOR-347). Every
  // submitted MR requires approval (there is no within-your-own-cap direct
  // path), so PENDING_APPROVAL fires on submission; UNROUTABLE is the same
  // empty-Pool fallback, raised when nobody in the company holds
  // `materialRequest.approve`.
  MATERIAL_REQUEST_PENDING_APPROVAL
  MATERIAL_REQUEST_APPROVAL_UNROUTABLE
  PAYMENT_DUE
  PAYMENT_OVERDUE
  // Daily overdue reminders (FOR-394): a requested item passed its date and is
  // still unfulfilled — an MR not yet ordered, an RFQ not yet awarded, a PO not
  // yet delivered. Sent once per document (ledger: overdueReminderSentAt).
  MATERIAL_REQUEST_OVERDUE
  RFQ_OVERDUE
  PO_DELIVERY_OVERDUE
  MESSAGE_RECEIVED
}

// The kind of document a notification points at. Drives the front-end deep link
// (entityType + entityId, plus any extra ids carried in `metadata`, e.g. rfqId
// for a QUOTE_RESPONSE). Nullable on Notification so system messages without a
// target still render.
enum NotificationEntityType {
  RFQ
  QUOTE_RESPONSE
  PURCHASE_ORDER
  BULK_ORDER
  INVOICE
  MATERIAL_REQUEST
}

model Notification {
  id         String                  @id @default(uuid())
  userId     String                  @map("user_id")
  type       NotificationType
  title      String
  body       String?
  entityType NotificationEntityType? @map("entity_type")
  entityId   String?                 @map("entity_id")
  // Extra structured context for rendering / linking (e.g. { rfqId } so a
  // QUOTE_RESPONSE notification can build /rfqs/:rfqId/quotes/:quoteId).
  metadata   Json?
  readAt     DateTime?               @map("read_at")
  createdAt  DateTime                @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@index([userId, readAt], map: "idx_notifications_user_read")
  @@map("notifications")
}
