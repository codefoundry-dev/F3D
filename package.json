{
  "name": "forethread",
  "private": true,
  "version": "0.0.0",
  "description": "Forethread — B2B Procurement Management Platform (monorepo)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test --concurrency=2",
    "test:coverage": "turbo test:coverage --concurrency=2",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -not -path '*/.git/*' | xargs rm -rf",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.65.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@<1.20.9": "^1.20.9",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "follow-redirects@<1.16.0": "^1.16.0",
      "fast-xml-parser@>=5.0.0 <5.12.0": "^5.12.0",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "multer@<2.5.0": "^2.5.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "esbuild@<0.25.0": "^0.25.0",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "lodash@<4.18.1": "^4.18.1",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "tar@<7.5.21": "^7.5.21",
      "tinypool@<2.1.2": "^2.1.2",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@<11.1.1": "^11.1.1",
      "webpack@>=5.49.0 <5.104.1": "^5.104.1",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    },
    "packageExtensions": {
      "@nestjs/platform-express@11": {
        "peerDependencies": {
          "rxjs": "^7.1.0"
        }
      }
    },
    "patchedDependencies": {}
  }
}
